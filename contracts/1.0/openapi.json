{
  "openapi": "3.1.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "AirlineDemo Workflow API",
    "version": "1.0",
    "description": "Scoped, versioned contract for workflow fixture generation and consumers. Package processing is persisted and exposes explicit completion, failure, retry, and recovery state."
  },
  "servers": [
    {
      "url": "/api"
    }
  ],
  "tags": [
    {
      "name": "Packages"
    },
    {
      "name": "Operations"
    },
    {
      "name": "Cases"
    },
    {
      "name": "Evidence"
    },
    {
      "name": "Runs"
    }
  ],
  "paths": {
    "/packages": {
      "post": {
        "tags": [
          "Packages"
        ],
        "operationId": "submitPackage",
        "summary": "Submit a versioned package event",
        "description": "The caller must be authenticated and scoped to the package case. Replaying an event with an unchanged canonical payload is idempotent; reusing its event ID with a changed canonical payload is a conflict.",
        "security": [
          {
            "WorkflowBearer": []
          }
        ],
        "x-required-scopes": [
          "workflow.write"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PackageSubmissionRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Submission accepted for processing.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperationAccepted"
                },
                "example": {
                  "operationId": "OP-0001",
                  "caseId": "CASE-0001",
                  "receiptId": "RECEIPT-0001"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidPayload"
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "403": {
            "$ref": "#/components/responses/ActionForbidden"
          },
          "409": {
            "$ref": "#/components/responses/EventPayloadConflict"
          }
        }
      }
    },
    "/demo/runs/{runId}": {
      "delete": {
        "tags": [
          "Runs"
        ],
        "operationId": "resetDemoRun",
        "summary": "Reset one confirmed demonstration run",
        "description": "The authenticated caller must own the named run and explicitly confirm with RESET. Only application-owned records for that run are removed; the reset receipt is retained.",
        "security": [
          {
            "WorkflowBearer": []
          }
        ],
        "x-required-scopes": [
          "workflow.write"
        ],
        "parameters": [
          {
            "name": "runId",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RunResetRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The named run was reset and a receipt was persisted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResetAccepted"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidPayload"
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "403": {
            "$ref": "#/components/responses/ActionForbidden"
          }
        }
      }
    },
    "/operations/{id}": {
      "get": {
        "tags": [
          "Operations"
        ],
        "operationId": "getOperation",
        "summary": "Look up a submission operation",
        "security": [
          {
            "WorkflowBearer": []
          }
        ],
        "x-required-scopes": [
          "workflow.read"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ResourceId"
          }
        ],
        "responses": {
          "200": {
            "description": "Current operation status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperationStatus"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidPayload"
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "403": {
            "$ref": "#/components/responses/ActionForbidden"
          },
          "404": {
            "$ref": "#/components/responses/OperationNotFound"
          }
        }
      }
    },
    "/operations/{id}/process": {
      "post": {
        "tags": [
          "Operations"
        ],
        "operationId": "processOperation",
        "summary": "Process a queued package or resume processing",
        "description": "Moves the operation to processing and accounts for every manifest-declared file. The same operation and submission receipt are retained across completion or failure.",
        "security": [
          {
            "WorkflowBearer": []
          }
        ],
        "x-required-scopes": [
          "workflow.write"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ResourceId"
          }
        ],
        "responses": {
          "202": {
            "description": "Processing was recorded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperationAccepted"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "404": {
            "$ref": "#/components/responses/OperationNotFound"
          },
          "409": {
            "$ref": "#/components/responses/InvalidPayload"
          }
        }
      }
    },
    "/operations/{id}/retry": {
      "post": {
        "tags": [
          "Operations"
        ],
        "operationId": "retryOperation",
        "summary": "Retry a failed package operation",
        "description": "Creates a new processing attempt for a failed operation while preserving its prior attempt, package record, and submission receipt.",
        "security": [
          {
            "WorkflowBearer": []
          }
        ],
        "x-required-scopes": [
          "workflow.write"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ResourceId"
          }
        ],
        "responses": {
          "202": {
            "description": "Retry was recorded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperationAccepted"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "404": {
            "$ref": "#/components/responses/OperationNotFound"
          },
          "409": {
            "$ref": "#/components/responses/InvalidPayload"
          }
        }
      }
    },
    "/packages/{id}/process": {
      "$ref": "#/paths/~1operations~1{id}~1process"
    },
    "/packages/{id}/retry": {
      "$ref": "#/paths/~1operations~1{id}~1retry"
    },
    "/cases/{id}": {
      "get": {
        "tags": [
          "Cases"
        ],
        "operationId": "getCase",
        "summary": "Look up a scoped case",
        "security": [
          {
            "WorkflowBearer": []
          }
        ],
        "x-required-scopes": [
          "case.read"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ResourceId"
          }
        ],
        "responses": {
          "200": {
            "description": "Scoped case summary.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CaseSummary"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "403": {
            "$ref": "#/components/responses/ActionForbidden"
          },
          "404": {
            "$ref": "#/components/responses/CaseNotFound"
          }
        }
      }
    },
    "/cases/{id}/evidence/{documentId}": {
      "get": {
        "tags": [
          "Evidence"
        ],
        "operationId": "previewEvidence",
        "summary": "Preview a permitted evidence page",
        "security": [
          {
            "WorkflowBearer": []
          }
        ],
        "x-required-scopes": [
          "evidence.read"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ResourceId"
          },
          {
            "name": "documentId",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Id"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "version",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Authorised page preview without a blob locator.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvidencePreview"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidPayload"
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "403": {
            "$ref": "#/components/responses/ActionForbidden"
          },
          "404": {
            "$ref": "#/components/responses/EvidenceNotFound"
          }
        }
      }
    },
    "/cases/{id}/reviews": {
        "post": {
          "tags": [
            "Cases"
          ],
          "operationId": "submitReview",
          "summary": "Record an authorised current-basis review decision",
          "security": [
            {
              "WorkflowBearer": []
            }
          ],
          "x-required-scopes": [
            "case.review"
          ],
          "parameters": [
            {
              "$ref": "#/components/parameters/ResourceId"
            },
            {
              "name": "If-Match",
              "in": "header",
              "required": true,
              "schema": {
                "type": "string",
                "pattern": "^\\\"[1-9][0-9]*\\\"$"
              },
              "description": "The expected server-controlled case revision."
            }
          ],
          "requestBody": {
            "required": true,
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewCommand"
                }
              }
            }
          },
          "responses": {
            "200": {
              "description": "The immutable review decision and audit entry were committed.",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/ReviewDecision"
                  }
                }
              }
            },
            "400": {
              "$ref": "#/components/responses/InvalidPayload"
            },
            "401": {
              "$ref": "#/components/responses/AuthenticationRequired"
            },
            "404": {
              "$ref": "#/components/responses/CaseNotFound"
            },
            "412": {
              "$ref": "#/components/responses/StalePrecondition"
            }
          }
        }
      },
      "/cases/{id}/review-tasks/{taskId}/complete": {
        "post": {
          "tags": [
            "Cases"
          ],
          "operationId": "completeReviewTask",
          "summary": "Complete a current scoped review task without accepting evidence",
          "security": [
            {
              "WorkflowBearer": []
            }
          ],
          "x-required-scopes": [
            "case.review"
          ],
          "parameters": [
            {
              "$ref": "#/components/parameters/ResourceId"
            },
            {
              "name": "taskId",
              "in": "path",
              "required": true,
              "schema": {
                "$ref": "#/components/schemas/Id"
              }
            },
            {
              "name": "If-Match",
              "in": "header",
              "required": true,
              "schema": {
                "type": "string",
                "pattern": "^\\\"[1-9][0-9]*\\\"$"
              },
              "description": "The expected server-controlled case revision."
            }
          ],
          "responses": {
            "200": {
              "description": "The task was completed; no evidence acceptance was created.",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/ReviewTask"
                  }
                }
              }
            },
            "400": {
              "$ref": "#/components/responses/InvalidPayload"
            },
            "401": {
              "$ref": "#/components/responses/AuthenticationRequired"
            },
            "404": {
              "$ref": "#/components/responses/CaseNotFound"
            },
            "412": {
              "$ref": "#/components/responses/StalePrecondition"
            }
          }
        }
      }
  },
  "components": {
    "securitySchemes": {
      "WorkflowBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "An authenticated caller whose token is checked against the resource's airline/aircraft/lease scope."
      }
    },
    "parameters": {
      "ResourceId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/Id"
        }
      }
    },
    "responses": {
      "AuthenticationRequired": {
        "description": "Authentication is missing or invalid.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/SafeError"
            }
          }
        }
      },
      "ActionForbidden": {
        "description": "The authenticated caller cannot perform this action in its visible scope.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/SafeError"
            }
          }
        }
      },
      "InvalidPayload": {
        "description": "The request payload or parameter is invalid.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/SafeError"
            }
          }
        }
      },
      "CaseNotFound": {
        "description": "The case is not accessible in the caller's scope.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/SafeError"
            }
          }
        }
      },
      "EvidenceNotFound": {
        "description": "The evidence is not accessible in the caller's scope.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/SafeError"
            }
          }
        }
      },
      "OperationNotFound": {
        "description": "The operation is not accessible in the caller's scope.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/SafeError"
            }
          }
        }
      },
      "EventPayloadConflict": {
        "description": "The event ID has already been used with a different canonical payload.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/SafeError"
            }
          }
        }
      },
      "StalePrecondition": {
        "description": "The case revision or evidence basis is no longer current.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/SafeError"
            }
          }
        }
      }
    },
    "schemas": {
      "Id": {
        "$ref": "workflow.schema.json#/$defs/Id"
      },
      "CaseContext": {
        "$ref": "workflow.schema.json#/$defs/CaseContext"
      },
      "Document": {
        "$ref": "workflow.schema.json#/$defs/Document"
      },
      "EvidenceRef": {
        "$ref": "workflow.schema.json#/$defs/EvidenceRef"
      },
      "SubmissionPackage": {
        "$ref": "workflow.schema.json#/$defs/SubmissionPackage"
      },
      "EventEnvelope": {
        "$ref": "workflow.schema.json#/$defs/EventEnvelope"
      },
      "PackageSubmissionRequest": {
        "$ref": "workflow.schema.json#/$defs/PackageSubmissionRequest"
      },
      "OperationAccepted": {
        "$ref": "workflow.schema.json#/$defs/OperationAccepted"
      },
      "RunResetRequest": {
        "type": "object",
        "properties": {
          "runId": {
            "$ref": "#/components/schemas/Id"
          },
          "confirmation": {
            "type": "string",
            "const": "RESET"
          }
        },
        "required": [
          "runId",
          "confirmation"
        ],
        "additionalProperties": false
      },
      "ResetAccepted": {
        "type": "object",
        "properties": {
          "runId": {
            "$ref": "#/components/schemas/Id"
          },
          "receiptId": {
            "$ref": "#/components/schemas/Id"
          },
          "affectedRecordCount": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "runId",
          "receiptId",
          "affectedRecordCount"
        ],
        "additionalProperties": false
      },
      "OperationStatus": {
        "$ref": "workflow.schema.json#/$defs/OperationStatus"
      },
      "ProcessingAttemptStatus": {
        "$ref": "workflow.schema.json#/$defs/ProcessingAttemptStatus"
      },
      "CaseSummary": {
        "$ref": "workflow.schema.json#/$defs/CaseSummary"
      },
      "PackageProcessingStatus": {
        "$ref": "workflow.schema.json#/$defs/PackageProcessingStatus"
      },
      "EvidencePreview": {
        "$ref": "workflow.schema.json#/$defs/EvidencePreview"
      },
      "ReviewCommand": {
        "$ref": "workflow.schema.json#/$defs/ReviewCommand"
      },
      "ReviewDecision": {
        "$ref": "workflow.schema.json#/$defs/ReviewDecision"
      },
      "ReviewTask": {
        "$ref": "workflow.schema.json#/$defs/ReviewTask"
      },
      "AuditEntry": {
        "$ref": "workflow.schema.json#/$defs/AuditEntry"
      },
      "SafeError": {
        "$ref": "workflow.schema.json#/$defs/SafeError"
      }
    }
  }
}
