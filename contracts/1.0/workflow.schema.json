{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://airlinedemo.example/contracts/workflow/1.0/workflow.schema.json",
  "title": "AirlineDemo workflow contract",
  "description": "Versioned integration objects shared by fixture generators and workflow consumers.",
  "type": "object",
  "required": [
    "schemaVersion"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "SchemaVersion": {
      "type": "string",
      "enum": [
        "1.0"
      ]
    },
    "Id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "UtcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "CaseContext": {
      "type": "object",
      "required": [
        "runId",
        "caseId",
        "airlineId",
        "aircraftId",
        "leaseId"
      ],
      "properties": {
        "runId": {
          "$ref": "#/$defs/Id"
        },
        "caseId": {
          "$ref": "#/$defs/Id"
        },
        "airlineId": {
          "$ref": "#/$defs/Id"
        },
        "aircraftId": {
          "$ref": "#/$defs/Id"
        },
        "leaseId": {
          "$ref": "#/$defs/Id"
        }
      },
      "additionalProperties": false
    },
    "Asset": {
      "type": "object",
      "required": [
        "aircraftId",
        "engineId",
        "components",
        "referenceSource"
      ],
      "properties": {
        "aircraftId": {
          "$ref": "#/$defs/Id"
        },
        "engineId": {
          "$ref": "#/$defs/Id"
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "componentId",
              "serialNumber"
            ],
            "properties": {
              "componentId": {
                "$ref": "#/$defs/Id"
              },
              "serialNumber": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            },
            "additionalProperties": false
          }
        },
        "referenceSource": {
          "type": "object",
          "required": [
            "identity",
            "version"
          ],
          "properties": {
            "identity": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "version": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "Requirement": {
      "type": "object",
      "required": [
        "requirementId",
        "version",
        "componentId",
        "evidenceKind",
        "description",
        "applicability",
        "approvedBy",
        "approvedAt",
        "sourceRef"
      ],
      "properties": {
        "requirementId": {
          "$ref": "#/$defs/Id"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "componentId": {
          "$ref": "#/$defs/Id"
        },
        "evidenceKind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "applicability": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "approvedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "approvedAt": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "sourceRef": {
          "$ref": "#/$defs/Id"
        },
        "requiredFrom": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "requiredTo": {
          "$ref": "#/$defs/UtcTimestamp"
        }
      },
      "additionalProperties": false
    },
    "Document": {
      "type": "object",
      "required": [
        "documentId",
        "version",
        "sourceSystem",
        "sourceRecordId",
        "fileName",
        "mediaType",
        "sha256",
        "issuedOn"
      ],
      "properties": {
        "documentId": {
          "$ref": "#/$defs/Id"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "sourceSystem": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sourceRecordId": {
          "$ref": "#/$defs/Id"
        },
        "fileName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[^\\\\/]+$"
        },
        "mediaType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "issuedOn": {
          "$ref": "#/$defs/UtcTimestamp"
        }
      },
      "additionalProperties": false
    },
    "EvidenceBounds": {
      "type": "object",
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0
        },
        "y": {
          "type": "number",
          "minimum": 0
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": false
    },
    "EvidenceRef": {
      "type": "object",
      "required": [
        "documentId",
        "version",
        "page"
      ],
      "properties": {
        "documentId": {
          "$ref": "#/$defs/Id"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "bounds": {
          "$ref": "#/$defs/EvidenceBounds"
        },
        "quote": {
          "type": "string",
          "maxLength": 2000
        }
      },
      "additionalProperties": false
    },
    "ApprovedRequirementVersion": {
      "type": "object",
      "required": [
        "requirementId",
        "version"
      ],
      "properties": {
        "requirementId": {
          "$ref": "#/$defs/Id"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "EvidenceDocumentVersion": {
      "type": "object",
      "required": [
        "documentId",
        "version",
        "sha256"
      ],
      "properties": {
        "documentId": {
          "$ref": "#/$defs/Id"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "EvidenceBasis": {
      "type": "object",
      "required": [
        "basisId",
        "context",
        "documentInventory",
        "approvedRequirementVersions",
        "caseRevision",
        "createdAt",
        "parserVersion",
        "extractorVersion"
      ],
      "properties": {
        "basisId": {
          "$ref": "#/$defs/Id"
        },
        "context": {
          "$ref": "#/$defs/CaseContext"
        },
        "documentInventory": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvidenceDocumentVersion"
          }
        },
        "approvedRequirementVersions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ApprovedRequirementVersion"
          }
        },
        "caseRevision": {
          "type": "integer",
          "minimum": 1
        },
        "createdAt": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "parserVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "extractorVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "additionalProperties": false
    },
    "Finding": {
      "type": "object",
      "required": [
        "findingId",
        "componentId",
        "requirementId",
        "basisId",
        "assessment",
        "reasonCode",
        "explanation",
        "evidenceRefs"
      ],
      "properties": {
        "findingId": {
          "$ref": "#/$defs/Id"
        },
        "componentId": {
          "$ref": "#/$defs/Id"
        },
        "requirementId": {
          "$ref": "#/$defs/Id"
        },
        "basisId": {
          "$ref": "#/$defs/Id"
        },
        "assessment": {
          "type": "string",
          "enum": [
            "satisfied",
            "missing",
            "ambiguous",
            "conflicting",
            "blocked"
          ]
        },
        "reasonCode": {
          "$ref": "#/$defs/Id"
        },
        "explanation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          }
        }
      },
      "additionalProperties": false
    },
    "InvestigationResult": {
      "type": "object",
      "required": [
        "findings"
      ],
      "properties": {
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Finding"
          }
        }
      },
      "additionalProperties": false
    },
    "InvestigationOutcome": {
      "type": "object",
      "required": [
        "basisId",
        "context",
        "status",
        "findings",
        "correlationId"
      ],
      "properties": {
        "basisId": {
          "$ref": "#/$defs/Id"
        },
        "context": {
          "$ref": "#/$defs/CaseContext"
        },
        "status": {
          "type": "string",
          "enum": [
            "complete",
            "blocked"
          ]
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Finding"
          }
        },
        "error": {
          "$ref": "#/$defs/SafeError"
        },
        "correlationId": {
          "$ref": "#/$defs/Id"
        }
      },
      "additionalProperties": false
    },
    "SubmissionPackage": {
      "type": "object",
      "required": [
        "schemaVersion",
        "packageId",
        "runId",
        "caseId",
        "airlineId",
        "aircraftId",
        "leaseId",
        "submittedAt",
        "scenarioEffectiveAt",
        "manifest"
      ],
      "properties": {
        "schemaVersion": {
          "$ref": "#/$defs/SchemaVersion"
        },
        "packageId": {
          "$ref": "#/$defs/Id"
        },
        "runId": {
          "$ref": "#/$defs/Id"
        },
        "caseId": {
          "$ref": "#/$defs/Id"
        },
        "airlineId": {
          "$ref": "#/$defs/Id"
        },
        "aircraftId": {
          "$ref": "#/$defs/Id"
        },
        "leaseId": {
          "$ref": "#/$defs/Id"
        },
        "submittedAt": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "scenarioEffectiveAt": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "manifest": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/Document"
          }
        }
      },
      "additionalProperties": false
    },
    "PackageSubmittedPayload": {
      "type": "object",
      "required": [
        "packageId"
      ],
      "properties": {
        "packageId": {
          "$ref": "#/$defs/Id"
        }
      },
      "additionalProperties": false
    },
    "PartnerResponseReceivedPayload": {
      "type": "object",
      "required": [
        "packageId",
        "requestId"
      ],
      "properties": {
        "packageId": {
          "$ref": "#/$defs/Id"
        },
        "requestId": {
          "$ref": "#/$defs/Id"
        }
      },
      "additionalProperties": false
    },
    "EventEnvelope": {
      "type": "object",
      "required": [
        "schemaVersion",
        "eventId",
        "type",
        "runId",
        "caseId",
        "airlineId",
        "aircraftId",
        "leaseId",
        "occurredAt",
        "scenarioEffectiveAt",
        "correlationId",
        "payload"
      ],
      "properties": {
        "schemaVersion": {
          "$ref": "#/$defs/SchemaVersion"
        },
        "eventId": {
          "$ref": "#/$defs/Id"
        },
        "type": {
          "type": "string",
          "enum": [
            "package.submitted",
            "partner.response.received"
          ]
        },
        "runId": {
          "$ref": "#/$defs/Id"
        },
        "caseId": {
          "$ref": "#/$defs/Id"
        },
        "airlineId": {
          "$ref": "#/$defs/Id"
        },
        "aircraftId": {
          "$ref": "#/$defs/Id"
        },
        "leaseId": {
          "$ref": "#/$defs/Id"
        },
        "occurredAt": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "scenarioEffectiveAt": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "correlationId": {
          "$ref": "#/$defs/Id"
        },
        "payload": {
          "oneOf": [
            {
              "$ref": "#/$defs/PackageSubmittedPayload"
            },
            {
              "$ref": "#/$defs/PartnerResponseReceivedPayload"
            }
          ]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "package.submitted"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/PackageSubmittedPayload"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "partner.response.received"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/PartnerResponseReceivedPayload"
              }
            }
          }
        }
      ]
    },
    "OperationAccepted": {
      "type": "object",
      "required": [
        "operationId",
        "caseId",
        "receiptId"
      ],
      "properties": {
        "operationId": {
          "$ref": "#/$defs/Id"
        },
        "caseId": {
          "$ref": "#/$defs/Id"
        },
        "receiptId": {
          "$ref": "#/$defs/Id"
        }
      },
      "additionalProperties": false
    },
    "ProcessingAttemptStatus": {
      "type": "object",
      "required": [
        "attemptId",
        "attemptNumber",
        "status"
      ],
      "properties": {
        "attemptId": {
          "$ref": "#/$defs/Id"
        },
        "attemptNumber": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "processing",
            "complete",
            "failed"
          ]
        },
        "error": {
          "$ref": "#/$defs/SafeError"
        }
      },
      "additionalProperties": false
    },
    "OperationStatus": {
      "type": "object",
      "required": [
        "operationId",
        "caseId",
        "runId",
        "airlineId",
        "aircraftId",
        "leaseId",
        "status"
      ],
      "properties": {
        "operationId": {
          "$ref": "#/$defs/Id"
        },
        "caseId": {
          "$ref": "#/$defs/Id"
        },
        "runId": {
          "$ref": "#/$defs/Id"
        },
        "airlineId": {
          "$ref": "#/$defs/Id"
        },
        "aircraftId": {
          "$ref": "#/$defs/Id"
        },
        "leaseId": {
          "$ref": "#/$defs/Id"
        },
        "status": {
          "type": "string",
          "enum": [
            "queued",
            "processing",
            "complete",
            "failed"
          ]
        },
        "error": {
          "$ref": "#/$defs/SafeError"
        },
        "attempts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProcessingAttemptStatus"
          }
        }
      },
      "additionalProperties": false
    },
    "CaseSummary": {
      "type": "object",
      "required": [
        "caseId",
        "runId",
        "airlineId",
        "aircraftId",
        "leaseId",
        "caseRevision",
        "status",
        "packageProcessing"
      ],
      "properties": {
        "caseId": {
          "$ref": "#/$defs/Id"
        },
        "runId": {
          "$ref": "#/$defs/Id"
        },
        "airlineId": {
          "$ref": "#/$defs/Id"
        },
        "aircraftId": {
          "$ref": "#/$defs/Id"
        },
        "leaseId": {
          "$ref": "#/$defs/Id"
        },
        "caseRevision": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "awaiting_external",
            "awaiting_review",
            "ready_for_acceptance",
            "accepted",
            "blocked"
          ]
        },
        "packageProcessing": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PackageProcessingStatus"
          }
        },
        "investigation": {
          "$ref": "#/$defs/InvestigationOutcome"
        }
      },
      "additionalProperties": false
    },
    "PackageProcessingStatus": {
      "type": "object",
      "required": [
        "packageId",
        "operationId",
        "status"
      ],
      "properties": {
        "packageId": {
          "$ref": "#/$defs/Id"
        },
        "operationId": {
          "$ref": "#/$defs/Id"
        },
        "status": {
          "type": "string",
          "enum": [
            "queued",
            "processing",
            "complete",
            "failed"
          ]
        },
        "error": {
          "$ref": "#/$defs/SafeError"
        }
      },
      "additionalProperties": false
    },
    "EvidencePreview": {
      "type": "object",
      "required": [
        "documentId",
        "version",
        "page",
        "mediaType",
        "textExcerpt"
      ],
      "properties": {
        "documentId": {
          "$ref": "#/$defs/Id"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "mediaType": {
          "type": "string",
          "minLength": 1
        },
        "textExcerpt": {
          "type": "string",
          "maxLength": 10000
        },
        "bounds": {
          "$ref": "#/$defs/EvidenceBounds"
        }
      },
      "additionalProperties": false
    },
    "PackageSubmissionRequest": {
      "type": "object",
      "required": [
        "event",
        "package"
      ],
      "properties": {
        "event": {
          "$ref": "#/$defs/EventEnvelope"
        },
        "package": {
          "$ref": "#/$defs/SubmissionPackage"
        }
      },
      "additionalProperties": false
    },
    "SafeError": {
      "type": "object",
      "required": [
        "safeCode",
        "correlationId"
      ],
      "properties": {
        "safeCode": {
          "type": "string",
          "enum": [
            "AUTHENTICATION_REQUIRED",
            "INVALID_AUTHENTICATION",
            "CASE_NOT_FOUND",
            "EVIDENCE_NOT_FOUND",
            "OPERATION_NOT_FOUND",
            "ACTION_FORBIDDEN",
            "INVALID_PAYLOAD",
            "EVENT_PAYLOAD_CONFLICT",
            "INVESTIGATION_BASIS_NOT_FOUND",
            "INVESTIGATION_CALL_LIMIT",
            "INVESTIGATION_CONTEXT_LIMIT",
            "INVESTIGATION_OUTPUT_INVALID",
            "INVESTIGATION_PAGE_LIMIT",
            "INVESTIGATION_RETRY_LIMIT",
            "INVESTIGATION_TIMEOUT"
          ]
        },
        "correlationId": {
          "$ref": "#/$defs/Id"
        },
        "message": {
          "type": "string",
          "maxLength": 256
        }
      },
      "additionalProperties": false
    }
  }
}
