      },
      "summary": "The raw compressed-structure scan can reject valid PDFs when comments contain marker-like names.",
      "findingList": [
        {
          "severity": "major",
          "file": "backend/AirlineDemo.Api/Evidence/EvidenceIntake.cs",
          "line": 153,
          "message": "The compressed-structure scan treats names in PDF comments as structural entries, rejecting valid text PDFs.",
          "confidence": 0.94,
          "category": "logic-error",
          "evidence": {
            "codePathTraced": "ValidateBytes calls RejectCompressedStructure before PdfPig parses the document. That method removes stream bodies, then NameRegex scans the remaining raw PDF bytes without ignoring comments.",
            "failureScenario": "A valid text PDF contains the comment `% /Type /ObjStm` before its objects. The scanner sees the adjacent Type and ObjStm names and rejects the document as UnsupportedFormat, so valid text evidence cannot be processed."
          }
        }
      ]
    },
    {
      "agentId": "test-reviewer-codex",
      "reviewType": "testing",
      "harness": "codex",
      "harnessVersion": "0.162.0",
      "model": "gpt-6-luna",
      "approved": false,
      "findings": {
        "critical": 0,
        "major": 1,
        "minor": 0,
        "suggestion": 0
      },
      "summary": "The tests cover the stated count, byte, and page boundaries and many PDF rejection paths. Decoded-size enforcement does not cover every stream in a document.",
      "findingList": [
        {
          "severity": "major",
          "file": "backend/AirlineDemo.Api/Evidence/EvidenceIntake.cs",
          "line": 302,
          "message": "Decoded-size limits omit streams outside page contents and catalog metadata, leaving embedded font streams unchecked.",
          "confidence": 0.86,
          "category": "security",
          "evidence": {
            "codePathTraced": "MeasureDecodedContent checks page /Contents streams, and MeasureCatalogMetadata checks the catalog /Metadata stream. Other streams, such as embedded font streams referenced by page resources, are not passed to AddDecodedLength.",
            "failureScenario": "A text PDF contains an embedded font stream that decodes beyond the 10 MB limit. The intake does not measure that stream, so it can accept the document despite the requirement to bound every stream's decoded size. This is an unbounded resource risk (A06:2025)."
          }
        }
      ]
    },
    {
      "agentId": "security-reviewer",
      "reviewType": "security",
      "harness": "codex",
      "harnessVersion": "0.162.0",
      "model": "gpt-6-luna",
      "approved": false,
      "findings": {
        "critical": 0,
        "major": 1,
        "minor": 0,
        "suggestion": 0
      },
      "summary": "The decoded-stream limits may run too late to prevent resource exhaustion: page loading occurs before the explicit size checks.",
      "findingList": [
        {
          "severity": "major",
          "file": "backend/AirlineDemo.Api/Evidence/EvidenceIntake.cs",
          "line": 512,
          "message": "Decoded-stream limits are enforced after page loading, leaving a resource-exhaustion path for highly compressed PDFs (A06:2025, Insecure Design).",
          "confidence": 0.84,
          "category": "security",
          "evidence": {
            "codePathTraced": "ExtractDocument calls PdfDocument.Open and then pdf.GetPage(page) before MeasureDecodedContent checks the decoded-stream limits. Page loading can decode content while constructing the page, before those limits are enforced.",
            "failureScenario": "A caller submits a PDF under the input-byte limit with a highly compressed page stream that expands substantially. PdfPig decodes the stream while loading the page, potentially exhausting service memory before intake can reject it at the decoded-size check."
          }
        }
      ]
    }
  ],
