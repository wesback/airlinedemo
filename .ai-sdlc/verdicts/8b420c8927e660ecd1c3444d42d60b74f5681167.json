          "severity": "major",
          "file": "backend/AirlineDemo.Api/Persistence/SqlCaseStateStore.cs",
          "line": 627,
          "message": "SQL receipt fingerprint reconstruction omits assessment and request receipt data, so an exact replay of a commit containing either record is rejected.",
          "confidence": 0.86,
          "category": "logic-error",
          "evidence": {
            "codePathTraced": "Commit fingerprints the assessment and request receipt along with the existing commit fields. Load rebuilds receipt fingerprints from decision rows, which do not persist those new payloads.",
            "failureScenario": "A SQL commit with a ReceiptId, Assessment, and RequestReceipt succeeds. When the same commit is retried, the rebuilt fingerprint omits the assessment and receipt, so the exact replay is rejected as reuse of the receipt ID."
          }
        }
      ]
