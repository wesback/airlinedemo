        "major": 1,
        "minor": 0,
        "suggestion": 0
      },
      "summary": "The limits, versioned storage, and several PDF rejection paths have criterion-mapped tests. However, page-level additional actions can carry scripts and bypass the parsed-content checks.",
      "findingList": [
        {
          "severity": "major",
          "file": "backend/AirlineDemo.Api/Evidence/EvidenceIntake.cs",
          "line": 280,
          "message": "Page-level additional actions are not checked, so a script-bearing PDF can be accepted as complete evidence.",
          "confidence": 0.91,
          "category": "security",
          "evidence": {
            "codePathTraced": "RejectActiveContent checks /AA on the document catalog, but the page-processing loop checks only /AF, annotations, and images. It never checks /AA in a page dictionary.",
            "failureScenario": "A text PDF with a page-level /AA entry containing a JavaScript action passes the catalog check. If text extraction succeeds, Process returns Complete and accepts a script-bearing PDF, contrary to the acceptance criterion. OWASP A06:2025 (Insecure Design)."
          }
        }
      ]
    },
    {
      "agentId": "security-reviewer",
      "reviewType": "security",
      "harness": "codex",
      "harnessVersion": "0.162.0",
      "model": "gpt-6-luna",
      "approved": false,
      "findings": {
        "critical": 0,
        "major": 1,
        "minor": 0,
        "suggestion": 0
      },
      "summary": "A compressed PDF can pass the input-size limit yet consume excessive memory while PdfPig materializes page text before the extracted-character limit is enforced.",
      "findingList": [
        {
          "severity": "major",
          "file": "backend/AirlineDemo.Api/Evidence/EvidenceIntake.cs",
          "line": 278,
          "message": "The extracted-text limit is checked after PdfPig materializes page text, so a small compressed PDF can exhaust memory during extraction.",
          "confidence": 0.82,
          "category": "security",
          "evidence": {
            "codePathTraced": "The 10 MB input limit bounds compressed PDF bytes, but page extraction evaluates pdfPage.Text before checking the extracted-character limit. PdfPig must decode and materialize the content before that check runs.",
            "failureScenario": "A caller submits a PDF under the byte limit with a highly compressed page content stream that expands to a very large amount of text. PdfPig materializes that text at pdfPage.Text before the character limit is checked, potentially exhausting service memory and disrupting other intake requests. OWASP A06:2025 (Insecure Design)."
          }
        }
      ]
    }
