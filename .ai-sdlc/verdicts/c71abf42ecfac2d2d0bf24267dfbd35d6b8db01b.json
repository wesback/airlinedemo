      "summary": "The intake checks catalog and annotation actions but misses additional actions stored directly on a page. A script-bearing PDF can therefore pass intake as complete.",
      "findingList": [
        {
          "severity": "major",
          "file": "backend/AirlineDemo.Api/Evidence/EvidenceIntake.cs",
          "line": 282,
          "message": "Page-level additional actions are not checked, allowing a PDF with a JavaScript action on a page to be accepted as complete evidence.",
          "confidence": 0.93,
          "category": "security",
          "evidence": {
            "codePathTraced": "ExtractDocument checks the page dictionary for /AF, then checks annotations and images. RejectActiveContent checks /AA only on the document catalog and annotations, not on page dictionaries.",
            "failureScenario": "A text PDF with a clean catalog and a page-level /AA entry containing a JavaScript action passes these checks. PdfPig extracts its text and Process returns Complete, accepting script-bearing evidence contrary to the acceptance criteria. OWASP A06:2025, Insecure Design."
          }
        }
      ]
    },
    {
      "agentId": "test-reviewer-codex",
