      "summary": "The log processor leaves pre-rendered messages untouched when there are no attributes or scopes, allowing sensitive interpolated text to reach the exporter.",
      "findingList": [
        {
          "severity": "major",
          "file": "backend/AirlineDemo.Api/Diagnostics/DiagnosticsSetup.cs",
          "line": 122,
          "message": "Rendered log messages bypass redaction when a record has no attributes or scopes. The exporter can receive sensitive interpolated text unchanged.",
          "confidence": 0.88,
          "category": "security",
          "evidence": {
            "codePathTraced": "RedactingLogProcessor.OnEnd returns without changing FormattedMessage when the record has no attributes or scopes.",
            "failureScenario": "A caller logs request-derived text using an interpolated string, such as `logger.LogInformation($\"Authorization: {token}\")`. If the record has no structured attributes or scopes, this return leaves the rendered text intact and the exporter can send the credential to Application Insights. OWASP A09:2025."
          }
        }
      ]
    }
