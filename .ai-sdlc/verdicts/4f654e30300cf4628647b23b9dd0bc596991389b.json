      "summary": "The gate checks registered hashes, but the registry accepts any content and does not establish that registrations came from committed synthetic fixtures.",
      "findingList": [
        {
          "severity": "major",
          "file": "backend/AirlineDemo.Api/Investigation/ApprovedModelManifest.cs",
          "line": 106,
          "message": "The registry can bless arbitrary content instead of restricting registration to committed synthetic fixtures, so registering real passenger data makes it pass the synthetic-content gate.",
          "confidence": 0.82,
          "category": "other",
          "evidence": {
            "codePathTraced": "SyntheticContentRegistry.Register hashes and accepts any content, and Authorize treats any registered hash as proof the content came from committed synthetic fixtures. The diff provides no fixture-backed restriction on registration.",
            "failureScenario": "Code registers a real passenger record, then submits it with the approved manifest and region. Its hash is now registered, so Authorize permits it to reach the model, contrary to M-07's fixture-backed synthetic-content requirement. This risks sensitive information disclosure (OWASP LLM02:2025)."
          }
        }
