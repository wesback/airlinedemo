      "summary": "The tests cover decision authorization, stale-basis rejection, audit provenance, and trace privacy. They do not exercise the acceptance endpoint with a previously valid decision made stale by a later basis, leaving that M-10 behavior unverified.",
      "findingList": [
        {
          "severity": "major",
          "file": "backend/AirlineDemo.Api.Tests/TechnicalReviewTests.cs",
          "line": 193,
          "message": "M-10 lacks an acceptance-path test for a stale prior decision. After adding a later basis, submit acceptance and assert it is denied without changing the case.",
          "confidence": 0.94,
          "category": "testing",
          "evidence": {
            "codePathTraced": "Later_basis_keeps_prior_decision_but_marks_it_non_current checks AuthorizesAcceptance(state), but does not call the acceptance endpoint. Legacy_acceptance_without_current_decision_is_denied tests only the no-decision case.",
            "failureScenario": "If the acceptance path is changed to allow any recorded accept decision, even when its basis is stale, both tests still pass. M-10 requires proving that a later basis prevents the prior decision from authorizing acceptance."
          }
        }
      ]
