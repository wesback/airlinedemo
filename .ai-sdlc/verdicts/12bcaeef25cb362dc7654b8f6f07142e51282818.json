      "summary": "The workflow runs a script supplied by the pull request while checkout credentials remain persisted in the repository configuration. A malicious PR can exfiltrate the read-only token.",
      "findingList": [
        {
          "severity": "major",
          "file": ".github/workflows/build.yml",
          "line": 17,
          "message": "A02:2025 — Set persist-credentials: false on checkout. The PR-controlled source checker can otherwise read and exfiltrate the persisted GitHub token.",
          "confidence": 0.86,
          "category": "security",
          "evidence": {
            "codePathTraced": "The pull-request workflow checks out code with the default credential persistence, then runs the PR-controlled backend/ci/check-sources.mjs script. The checkout token is stored in the repository’s local Git configuration and is readable by that script.",
            "failureScenario": "A malicious pull request changes check-sources.mjs to read the checkout token from .git/config and send it to an external server. The token has contents:read permission, so the workflow exposes a valid repository credential to PR-controlled code (OWASP A02:2025)."
          }
        }
      ]
    }
