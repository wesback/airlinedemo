      "summary": "The tests cover route mapping and session and scope denials, but they seed a test-only FinanceInputStore. In production, the newly registered store has no data source, so the routes cannot return populated finance results.",
      "findingList": [
        {
          "severity": "major",
          "file": "backend/AirlineDemo.Api/Program.cs",
          "line": 26,
          "message": "The production host registers an empty FinanceInputStore without wiring it to any finance or obligation data source. Populate it from the application’s case data so authorized requests can return the intended results.",
          "confidence": 0.82,
          "category": "logic-error",
          "evidence": {
            "codePathTraced": "Program registers a new FinanceInputStore, and the new store starts empty. The only Set calls shown are in tests; the reserve route calculates from missing inputs and the obligations route returns 404 when no obligation is stored.",
            "failureScenario": "After a production host starts, an authenticated in-scope request has no finance inputs to read: the reserve route returns a draft without report data, and the obligations route returns 404, so the client cannot display the finance and legal status."
          }
        }
      ]
