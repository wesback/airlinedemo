      },
      "summary": "The intake has reachable bypasses for deeply chained annotation actions and for decoded-size limits on multi-filter streams. Both can undermine the stated rejection and bounded-processing behavior.",
      "findingList": [
        {
          "severity": "major",
          "file": "backend/AirlineDemo.Api/Evidence/EvidenceIntake.cs",
          "line": 234,
          "message": "The action-chain depth limit silently accepts unchecked actions, so a deeply nested /Next chain can hide JavaScript from the active-content check (A06:2025, Insecure Design).",
          "confidence": 0.88,
          "category": "security",
          "evidence": {
            "codePathTraced": "RejectAnnotationContent follows annotation actions through RejectActionChain, which stops checking when the chain depth exceeds 16.",
            "failureScenario": "A submitted text PDF has an annotation action whose /Next chain places a JavaScript action beyond depth 16. The check returns without inspecting that action, and extraction can return Complete for a script-bearing PDF, contrary to the requirement to reject scripts (A06:2025, Insecure Design)."
          }
        },
        {
          "severity": "major",
          "file": "backend/AirlineDemo.Api/Evidence/EvidenceIntake.cs",
          "line": 306,
          "message": "Non-single-Flate streams are fully decoded before their size is checked, allowing a small multi-filter PDF to exhaust service resources (A06:2025, Insecure Design).",
          "confidence": 0.86,
          "category": "security",
          "evidence": {
            "codePathTraced": "DecodedLength uses stream.Decode(...).Count for streams that are not exactly a single FlateDecode filter, materializing the decoded stream before checking its size.",
            "failureScenario": "A caller submits a PDF under the input byte limit with a highly compressed content stream using multiple filters, such as ASCII85Decode followed by FlateDecode. Decoding can allocate the full expanded stream before the size check, potentially exhausting service memory and disrupting other intake requests (A06:2025, Insecure Design)."
          }
        }
      ]
    }
  ],
