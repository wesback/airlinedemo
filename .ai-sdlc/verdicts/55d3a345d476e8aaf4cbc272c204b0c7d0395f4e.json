      "summary": "The action-chain guard can let deeply nested JavaScript actions pass intake as complete evidence.",
      "findingList": [
        {
          "severity": "major",
          "file": "backend/AirlineDemo.Api/Evidence/EvidenceIntake.cs",
          "line": 240,
          "message": "The action-chain depth limit silently accepts deeper chains, allowing a nested JavaScript action to bypass rejection.",
          "confidence": 0.91,
          "category": "logic-error",
          "evidence": {
            "codePathTraced": "RejectActionChain returns without reporting an error when the action-chain depth exceeds 16. Annotation actions reach this method before text extraction.",
            "failureScenario": "A text PDF has an annotation action with 17 nested /Next actions and a /JavaScript action at the deepest level. The depth guard stops traversal before reaching the script, so intake can return Complete for a PDF containing active content, contrary to the acceptance criterion. OWASP A06:2025 (Insecure Design)."
          }
        }
      ]
    },
