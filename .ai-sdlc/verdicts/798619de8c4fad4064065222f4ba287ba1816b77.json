      "summary": "Repeated unauthenticated requests to protected case endpoints are not logged as auth/scope failures, leaving that reachable failure path outside the configured alert.",
      "findingList": [
        {
          "severity": "major",
          "file": "backend/AirlineDemo.Api/Auth/CaseEndpoints.cs",
          "line": 24,
          "message": "Unauthenticated requests to protected case endpoints bypass the auth/scope alert signal.",
          "confidence": 0.89,
          "category": "logic-error",
          "evidence": {
            "codePathTraced": "GetCase returns an unauthenticated response when CurrentSession is null without emitting AuthScopeFailure. RecordReview has the same unlogged unauthenticated path.",
            "failureScenario": "An unauthenticated caller repeatedly requests a protected case endpoint. Those authentication failures emit no security event, so the auth/scope alert does not count them and the configured owner is not notified. OWASP A09:2025."
          }
        }
      ]
    },
