      },
      "summary": "The intake implements the stated limits and parsed-content checks, but its raw stream-body stripping can reject valid text PDFs when stream text contains `endstream` followed by a structural marker.",
      "findingList": [
        {
          "severity": "major",
          "file": "backend/AirlineDemo.Api/Evidence/EvidenceIntake.cs",
          "line": 153,
          "message": "StreamBodyRegex can mistake text inside a PDF stream for the stream terminator, causing valid text PDFs containing `/ObjStm` or `/XRef` afterward to be rejected.",
          "confidence": 0.91,
          "category": "logic-error",
          "evidence": {
            "codePathTraced": "RejectCompressedStructure uses StreamBodyRegex to remove stream data before scanning for /ObjStm and /XRef. The regex stops at the first occurrence of the text endstream, without checking the stream's declared length.",
            "failureScenario": "A valid text PDF has a content string such as (endstream /ObjStm). The regex treats the word inside the string as the end of the stream, leaving /ObjStm for NameRegex to match. ValidateBytes then rejects the otherwise valid text PDF as UnsupportedFormat."
          }
        }
      ]
    },
    {
      "agentId": "test-reviewer-codex",
      "reviewType": "testing",
      "harness": "codex",
      "harnessVersion": "0.162.0",
      "model": "gpt-6-luna",
      "approved": false,
      "findings": {
        "critical": 0,
        "major": 2,
        "minor": 0,
        "suggestion": 0
      },
      "summary": "The tests cover many intake and storage behaviors, but they do not protect the parsed image-XObject rejection path or the aggregate decoded-byte limit required by the acceptance criteria.",
      "findingList": [
        {
          "severity": "major",
          "file": "backend/AirlineDemo.Api.Tests/EvidenceIntakeTests.cs",
          "line": 112,
          "message": "No test proves that a valid PDF with a parsed /Image XObject is rejected. The image subtype cases use malformed PDFs and assert Corrupt, so they do not cover this allowlist rule.",
          "confidence": 0.98,
          "category": "testing",
          "evidence": {
            "codePathTraced": "The image subtype theory feeds incomplete PDF stubs to intake and expects Corrupt, so it passes without exercising the parsed /Image XObject rejection. The valid Form XObject and inline image tests cover different paths.",
            "failureScenario": "If parsed /Image XObject rejection is removed, the theory still passes because PdfPig rejects its malformed stubs as Corrupt, and the other image tests do not use an /Image XObject. A valid text PDF containing an /Image XObject could then be accepted without a test failing, despite the acceptance criterion requiring one violating PDF per rule."
          }
        },
        {
          "severity": "major",
          "file": "backend/AirlineDemo.Api.Tests/EvidenceIntakeTests.cs",
          "line": 241,
          "message": "The required 50 MB per-document decoded-stream total has no test. The existing Flate bomb test only covers the 10 MB per-stream limit.",
          "confidence": 0.96,
          "category": "testing",
          "evidence": {
            "codePathTraced": "The Flate bomb test checks a single content stream exceeding the per-stream limit. There is no test that totals decoded streams across a document and rejects the document when that sum exceeds 50 MB.",
            "failureScenario": "If the per-document decoded-byte limit is removed or never applied, the current tests can still pass: the single-stream test fails at the 10 MB limit. A document with multiple streams each below 10 MB but totaling over 50 MB would lack a test that catches acceptance."
          }
        }
      ]
    },
    {
      "agentId": "security-reviewer",
      "reviewType": "security",
      "harness": "codex",
      "harnessVersion": "0.162.0",
      "model": "gpt-6-luna",
      "approved": false,
      "findings": {
        "critical": 0,
        "major": 1,
        "minor": 0,
        "suggestion": 0
      },
      "summary": "The allowed /Outlines catalog entry provides a path for a PDF containing executable actions to pass intake.",
      "findingList": [
        {
          "severity": "major",
          "file": "backend/AirlineDemo.Api/Evidence/EvidenceIntake.cs",
          "line": 226,
          "message": "Allowed outline trees are not checked for executable actions, so a PDF with a JavaScript or Launch action in an outline can be accepted as evidence (A06:2025, Insecure Design).",
          "confidence": 0.86,
          "category": "security",
          "evidence": {
            "codePathTraced": "The catalog allowlist accepts /Outlines, but the intake checks only the catalog's top-level keys and does not inspect outline items or their actions.",
            "failureScenario": "A text PDF has an allowed /Outlines entry whose outline item contains a /JavaScript or /Launch action. The catalog check passes, text extraction succeeds, and processing can return Complete for a PDF with executable content, contrary to the acceptance criteria."
          }
        }
      ]
    }
