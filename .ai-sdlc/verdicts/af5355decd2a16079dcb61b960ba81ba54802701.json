      },
      "summary": "The CMap comment handling, single-pass scan, and required preflight test cases have been added. Page-letter materialization still occurs before the text-size guard.",
      "findingList": [
        {
          "severity": "major",
          "file": "backend/AirlineDemo.Api/Evidence/IsolatedPdfParser.cs",
          "line": 145,
          "message": "The text bound is checked after PdfPig materializes page letters, leaving the previously reported extraction memory risk reachable.",
          "confidence": 0.84,
          "category": "security",
          "evidence": {
            "codePathTraced": "ParseCore evaluates getTextParts(page) before CanMaterializePageText checks the accumulated text. The production delegate enumerates page.Letters, so PdfPig can allocate the letter collection before that check.",
            "failureScenario": "A presenter submits a PDF with a text stream at the 512 KiB limit containing many glyphs. PdfPig materializes the letters while getTextParts(page) is enumerated, before the text bound is enforced; the resulting allocation can put excessive memory pressure on the API process. OWASP A06:2025."
          }
        }
      ]
    }
