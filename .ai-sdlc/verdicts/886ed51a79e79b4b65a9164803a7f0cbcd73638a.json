      "summary": "A current witness can describe an optional item as pending and still produce a missing-requirement request.",
      "findingList": [
        {
          "severity": "major",
          "file": "backend/AirlineDemo.Api/Investigation/ClaimValidator.cs",
          "line": 146,
          "message": "The missing-requirement checks treat an optional item as an open gap. Reject optional requirements before marking the claim supported. OWASP A08:2025.",
          "confidence": 0.9,
          "category": "logic-error",
          "evidence": {
            "codePathTraced": "For MissingRequirement claims, WitnessProblem accepts a quote when it contains an open-gap term and the typed value, unless it matches the negation, resolution, waiver, or embedded-instruction checks. The waiver check does not recognize “optional.” FindingRouter routes a supported MissingRequirement claim as a request.",
            "failureScenario": "With complete coverage, a current witness says “Reserve approval is pending but optional.” The claim uses “Reserve approval” as its typed value and is labeled MissingRequirement. Validation marks it Supported and routing creates a request, although the quote says the item is optional."
          }
        }
      ]
    },
    {
      "agentId": "test-reviewer-codex",
      "reviewType": "testing",
      "harness": "codex",
