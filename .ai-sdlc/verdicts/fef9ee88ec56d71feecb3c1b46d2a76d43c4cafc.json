      },
      "summary": "The AC-05 test does not capture all fields that can carry formatted text or exception details. A regression in either field can pass the test while sensitive data reaches the exporter.",
      "findingList": [
        {
          "severity": "major",
          "file": "backend/AirlineDemo.Api.Tests/DiagnosticsTests.cs",
          "line": 424,
          "message": "The AC-05 test sink omits FormattedMessage and Exception, so the test cannot detect leaks through those exported fields.",
          "confidence": 0.98,
          "category": "testing",
          "evidence": {
            "codePathTraced": "CaptureLogs.OnEnd snapshots LogRecord.Body and Attributes but ignores FormattedMessage and Exception. The AC-05 test builds its output from those snapshots, so it cannot detect leaks through either omitted field.",
            "failureScenario": "If the processor stops clearing FormattedMessage or Exception while continuing to replace Body and filter Attributes, the test still passes, though the exporter can receive the formatted canary or exception details in the no-property, safe-scope, or structured-property cases."
          }
        }
      ]
