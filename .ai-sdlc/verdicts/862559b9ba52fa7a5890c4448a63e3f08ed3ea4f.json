      "approved": false,
      "findings": {
        "critical": 0,
        "major": 1,
        "minor": 0,
        "suggestion": 0
      },
      "summary": "The tests map to the listed acceptance criteria, but an issued draft can be mutated through its exposed line list and then recorded by the Return path without consistency validation.",
      "findingList": [
        {
          "severity": "major",
          "file": "backend/AirlineDemo.Api/Finance/ReserveCalculator.cs",
          "line": 181,
          "message": "Validate or make calculated draft contents immutable before recording Return decisions; the current provenance check accepts an issued draft whose lines were modified.",
          "confidence": 0.86,
          "category": "logic-error",
          "evidence": {
            "codePathTraced": "Calculate returns a ReserveDraft whose Lines list is exposed as IReadOnlyList but remains castable to List<ReserveLine>. Review verifies calculation consistency for Approve, but Return only checks that the same draft object was issued by Calculate.",
            "failureScenario": "A caller calculates a ready draft, casts draft.Lines to List<ReserveLine>, changes a line amount, then submits Return. Review records the altered draft’s payable total without rejecting the tampering, contrary to AC4’s malformed-input validation requirement."
          }
        }
      ]
    },
