      "approved": false,
      "findings": {
        "critical": 0,
        "major": 1,
        "minor": 0,
        "suggestion": 0
      },
      "summary": "Reset isolation and preservation are covered by the tests. The fallback tests exercise a standalone helper, but the application reset path never uses it or returns fallback metadata.",
      "findingList": [
        {
          "severity": "major",
          "file": "backend/AirlineDemo.Api/Runs/DemoRunReset.cs",
          "line": 17,
          "message": "Fallback metadata validation is not connected to the reset flow, so the required traceable fallback is never recorded or enforced.",
          "confidence": 0.88,
          "category": "logic-error",
          "evidence": {
            "codePathTraced": "The reset endpoint calls Reset, which creates a new CaseState and returns it. ResolveFallback is not called by Reset or any other changed application path, and the reset result contains no fallback metadata.",
            "failureScenario": "When the demo uses the reset flow, it can return a new run without recording a reproducible fixture or application version; missing version metadata therefore cannot block fallback selection through this flow, despite the standalone helper test passing."
          }
        }
      ]
    },
