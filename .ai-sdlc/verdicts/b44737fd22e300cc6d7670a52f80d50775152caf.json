      "summary": "The diagnostics pipeline redacts exception details, but it unconditionally exports exception type metadata that AC-05 only permits when it passes the existing allowlist.",
      "findingList": [
        {
          "severity": "major",
          "file": "backend/AirlineDemo.Api/Diagnostics/DiagnosticsSetup.cs",
          "line": 100,
          "message": "Exception types are exported unconditionally as exception.type instead of being included only as an allowlisted error.type, contrary to AC-05.",
          "confidence": 0.92,
          "category": "logic-error",
          "evidence": {
            "codePathTraced": "RedactingLogProcessor.OnEnd adds exception.GetType().FullName as exception.type whenever structured data exists, then exports it with the redacted attributes.",
            "failureScenario": "When a log record has structured metadata and an exception type that is not on the approved allowlist, the pipeline still exports its full type name under exception.type. AC-05 permits only an approved error.type that passes the existing allowlist."
          }
        }
      ]
    },
