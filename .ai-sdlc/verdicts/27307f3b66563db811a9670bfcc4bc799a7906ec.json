          "message": "Manifest values are copied into traces without ensuring they contain no credentials.",
          "confidence": 0.83,
          "category": "security",
          "evidence": {
            "codePathTraced": "Authorize validates manifest fields only for emptiness, stub markers, and supported arm/filter values, then copies DeploymentName and the other manifest values into ModelCallTrace.",
