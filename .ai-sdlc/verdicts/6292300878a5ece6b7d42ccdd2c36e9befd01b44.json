      "approved": false,
      "findings": {
        "critical": 0,
        "major": 1,
        "minor": 0,
        "suggestion": 0
      },
      "summary": "The root-only Terraform file scan leaves a path for an instantiated child module to grant broader access to a workflow identity without failing the signing-rights test.",
      "findingList": [
        {
          "severity": "major",
          "file": "infra/terraform/tests/release-identity.tftest.hcl",
          "line": 369,
          "message": "The signing-rights test can miss extra grants declared in an instantiated child module. Include module assignments in the checks so a broader workflow identity grant fails the test.",
          "confidence": 0.87,
          "category": "security",
          "evidence": {
            "codePathTraced": "The role-assignment count uses fileset(path.module, \"*.tf\"), which scans only the Terraform module root. Terraform can also create assignments from a child module instantiated by the root configuration.",
            "failureScenario": "If a child module adds a resource-group-scoped Contributor assignment for the release identity, the Terraform test can apply that grant while the root-only assignment count and identity-reference checks remain unchanged. The release identity gains broader access without the test failing, contrary to AC RELEASE-ID-03 (OWASP A01:2025 Broken Access Control)."
          }
        }
      ]
    }
