      "summary": "The contract test can miss an indirect app-principal grant in a nested Terraform file, allowing an ACR access-control regression to pass.",
      "findingList": [
        {
          "severity": "major",
          "file": "backend/AirlineDemo.Api.Tests/ReleaseIdentityContractTests.cs",
          "line": 14,
          "message": "The contract test misses nested ACR grants when the app principal is referenced indirectly. Resolve or reject indirect principal references so an extra grant to the app identity fails the test.",
          "confidence": 0.84,
          "category": "security",
          "evidence": {
            "codePathTraced": "AppAcrGrantRoles counts a role assignment only when its block text directly matches AppIdentityReference. The Terraform test scans only root-module *.tf files, so a nested module assignment is checked only by this C# contract test.",
            "failureScenario": "If a nested Terraform module grants the app identity AcrPush on the ACR through a local principal that resolves to the app identity, the assignment block contains no direct azurerm_user_assigned_identity.app reference. AppAcrGrantRoles skips it and the test can pass with the extra grant, contrary to RELEASE-ID-01 (OWASP A01:2025 Broken Access Control)."
          }
        }
      ]
    },
    {
      "agentId": "test-reviewer-codex",
      "reviewType": "testing",
