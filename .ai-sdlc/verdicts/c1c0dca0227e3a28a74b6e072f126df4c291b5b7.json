      "findings": {
        "critical": 0,
        "major": 2,
        "minor": 0,
        "suggestion": 0
      },
      "summary": "The pre-parse structural scan can reject valid text PDFs that contain marker-like text. The tests also do not cover every catalog allowlist rule with an isolated violating PDF.",
      "findingList": [
        {
          "severity": "major",
          "file": "backend/AirlineDemo.Api/Evidence/EvidenceIntake.cs",
          "line": 155,
          "message": "The raw structural-name scan can mistake ordinary PDF text for an object stream and reject valid evidence.",
          "confidence": 0.91,
          "category": "logic-error",
          "evidence": {
            "codePathTraced": "ValidateBytes calls RejectCompressedStructure before parsing. That method scans every raw PDF name and rejects when /Type is followed by /ObjStm or /XRef, including names inside page text strings.",
            "failureScenario": "A valid text PDF contains the literal `(/Type /ObjStm)` in a content stream. The raw scan treats the text as PDF structure and returns UnsupportedFormat before PdfPig parses it, so valid text evidence is rejected."
          }
        },
        {
          "severity": "major",
          "file": "backend/AirlineDemo.Api.Tests/EvidenceIntakeTests.cs",
          "line": 145,
          "message": "The allowlist test criterion is incomplete: add isolated catalog tests for the prohibited catalog entries that are currently untested.",
          "confidence": 0.97,
          "category": "other",
          "evidence": {
            "codePathTraced": "The tests check one unlisted catalog key and several catalog cases, but do not test each prohibited catalog entry independently. For example, there are no isolated catalog cases for /AA, /JavaScript, or /Launch; the prohibited-key theory applies those entries to pages instead.",
            "failureScenario": "If the catalog checks for /AA, /JavaScript, or /Launch are removed, the existing page-key tests still pass. The acceptance criterion requiring a PDF that violates only each allowlist rule is therefore not covered."
          }
        }
      ]
    },
    {
      "agentId": "test-reviewer-codex",
      "reviewType": "testing",
      "harness": "codex",
      "harnessVersion": "0.162.0",
      "model": "gpt-6-luna",
      "approved": false,
      "findings": {
        "critical": 0,
        "major": 1,
        "minor": 0,
        "suggestion": 0
      },
      "summary": "The intake misses the required decoded-size bound for streams outside page content, leaving a reachable path for oversized decoded metadata to pass without the specified rejection.",
      "findingList": [
        {
          "severity": "major",
          "file": "backend/AirlineDemo.Api/Evidence/EvidenceIntake.cs",
          "line": 292,
          "message": "Decoded-size limits cover page content streams only. Other PDF streams, including an allowed catalog /Metadata stream, can exceed the per-stream or document decoded-size limit without being rejected.",
          "confidence": 0.87,
          "category": "security",
          "evidence": {
            "codePathTraced": "MeasureDecodedContent reads only each page's /Contents streams. The catalog allowlist permits /Metadata, but its stream is never measured.",
            "failureScenario": "A PDF within the input-byte limit has a /Metadata stream that expands beyond 10 MB. Since that stream is not a page /Contents stream, intake does not enforce the decoded-stream limit and may accept the document. This violates the decompression-bound requirement (A06:2025)."
          }
        }
      ]
    },
    {
      "agentId": "security-reviewer",
      "reviewType": "security",
      "harness": "codex",
      "harnessVersion": "0.162.0",
      "model": "gpt-6-luna",
      "approved": false,
      "findings": {
        "critical": 0,
        "major": 1,
        "minor": 0,
        "suggestion": 0
      },
      "summary": "The page check can miss Form XObjects declared in inherited resources, allowing disallowed PDF content to pass intake.",
      "findingList": [
        {
          "severity": "major",
          "file": "backend/AirlineDemo.Api/Evidence/EvidenceIntake.cs",
          "line": 322,
          "message": "The Form XObject rejection misses inherited page resources, allowing a PDF with a Form XObject to be accepted as evidence (A06:2025, Insecure Design).",
          "confidence": 0.82,
          "category": "security",
          "evidence": {
            "codePathTraced": "RejectPageContent checks /XObject only when it appears in page.Dictionary's direct /Resources entry. PDF page resources can be inherited from a parent page-tree node, which this check does not inspect.",
            "failureScenario": "A text PDF places a /Form XObject in an inherited /Resources dictionary and has no page-local /Resources entry. The Form check is skipped, text extraction can succeed, and Process can return Complete for a PDF that the acceptance criteria require rejecting."
          }
        }
      ]
    }
  ],
