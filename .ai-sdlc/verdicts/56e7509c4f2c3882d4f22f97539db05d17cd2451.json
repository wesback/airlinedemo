      },
      "summary": "The tests cover the named limit, retryability, versioning, and failed-intake behaviors. The intake still scans raw PDF text for image and active-content markers, so valid text can be rejected before parsed PDF content is checked.",
      "findingList": [
        {
          "severity": "major",
          "file": "backend/AirlineDemo.Api/Evidence/EvidenceIntake.cs",
          "line": 158,
          "message": "Raw-token scanning rejects valid text-only PDFs when their content contains marker-like text, contrary to the required parsed-content checks.",
          "confidence": 0.96,
          "category": "logic-error",
          "evidence": {
            "codePathTraced": "ValidateBytes scans the entire raw PDF text with ImageSubtype and ActiveContentMarkers before PdfPig parses the document.",
            "failureScenario": "A valid text-only PDF whose page text contains the literal `/Subtype /Image` matches ImageSubtype and fails as ActiveContent, even though it contains no image. The acceptance criteria require these checks to use parsed PDF data and explicitly rule out raw-byte token scans."
          }
        }
      ]
    },
