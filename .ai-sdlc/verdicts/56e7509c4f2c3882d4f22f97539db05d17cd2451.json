      "summary": "The intake rejects some valid text-only PDFs because it treats marker text anywhere in the raw file as executable content.",
      "findingList": [
        {
          "severity": "major",
          "file": "backend/AirlineDemo.Api/Evidence/EvidenceIntake.cs",
          "line": 158,
          "message": "The raw-byte active-content scan rejects ordinary text that happens to contain a marker. Determine script and form presence from parsed PDF entries, as the acceptance criteria require.",
          "confidence": 0.98,
          "category": "logic-error",
          "evidence": {
            "codePathTraced": "ValidateBytes searches the entire raw PDF text for active-content markers before PdfPig parses the document.",
            "failureScenario": "A valid text-only PDF contains the literal \"/JavaScript\" in a page text string. The scan finds that text and returns an ActiveContent failure, so the package is rejected despite containing no executable content."
          }
        }
      ]
    },
