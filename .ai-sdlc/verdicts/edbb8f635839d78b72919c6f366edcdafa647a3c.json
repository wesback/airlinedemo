      "summary": "The production label assertion now targets the loaded scene’s label host. The panel’s authorization merge can still briefly admit an action revoked by a newer server revision.",
      "findingList": [
        {
          "severity": "major",
          "file": "frontend/src/hangar/selectionPanel.tsx",
          "line": 110,
          "message": "The action union can retain authorization from an older revision after a newer server envelope revokes it, allowing a content request. Use actions from the same highest validated revision. OWASP A01:2025 Broken Access Control.",
          "confidence": 0.84,
          "category": "security",
          "evidence": {
            "codePathTraced": "The panel unions actions from its internal refreshSnapshot with actions from the newest envelope. The internal snapshot is synchronized from changed props in a useEffect, so it can still authorize actions from the previous revision during the render after a new envelope arrives.",
            "failureScenario": "If revision 7 authorizes evidence and revision 8 removes that permission, the panel can briefly keep Open content enabled from revision 7. With a content reader supplied, clicking during that interval issues a content request despite revision 8 denying it."
          }
        }
      ]
    }
