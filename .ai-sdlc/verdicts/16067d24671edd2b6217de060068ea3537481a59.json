      },
      "summary": "The log processor leaves Body unchanged for structured records, violating AC-05 and allowing sensitive literal text to reach the configured exporter.",
      "findingList": [
        {
          "severity": "major",
          "file": "backend/AirlineDemo.Api/Diagnostics/DiagnosticsSetup.cs",
          "line": 140,
          "message": "Structured log records retain their original body instead of using the required fixed `diagnostic event` body, so sensitive text in the body can reach telemetry.",
          "confidence": 0.98,
          "category": "security",
          "evidence": {
            "codePathTraced": "RedactingLogProcessor.OnEnd re-renders FormattedMessage from filtered attributes but leaves LogRecord.Body unchanged for records with log properties. The configured exporter receives the processed record.",
            "failureScenario": "A caller logs a structured message whose body contains sensitive literal text alongside a safe property. The unchanged body can reach the exporter, even though AC-05 requires every exported body to equal `diagnostic event`. The AC-05 test captures Body but does not assert that fixed value. OWASP A09:2025."
          }
        }
      ]
    }
