      "summary": "The parser and its tests cover the main isolation and limit behaviors, but CreateStartInfo does not meet the explicitly required public accessibility.",
      "findingList": [
        {
          "severity": "major",
          "file": "backend/AirlineDemo.Api/Evidence/IsolatedPdfParser.cs",
          "line": 113,
          "message": "CreateStartInfo is internal, though the acceptance criteria require it to be public.",
          "confidence": 0.99,
          "category": "design",
          "evidence": {
            "codePathTraced": "The acceptance criteria require CreateStartInfo to be public, but the method is declared internal. InternalsVisibleTo only grants access to the test assembly.",
            "failureScenario": "A caller outside AirlineDemo.Api and its friend assemblies cannot call CreateStartInfo, so the required public method is unavailable."
          }
        }
      ]
    },
