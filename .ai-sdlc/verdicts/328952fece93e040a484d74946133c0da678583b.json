      "summary": "The tests cover the main state, UTC-window, draft-history, and no-send behaviors. However, duplicate current drafts in the supplied history remain current, so the evaluator does not enforce the exactly-one-draft criterion.",
      "findingList": [
        {
          "severity": "major",
          "file": "backend/AirlineDemo.Api/Obligations/ObligationEvaluator.cs",
          "line": 97,
          "message": "Evaluate can return multiple current drafts for the same at-risk obligation when its input history already contains duplicates.",
          "confidence": 0.82,
          "category": "logic-error",
          "evidence": {
            "codePathTraced": "Evaluate keeps every current draft whose basis and EvidenceRequirementIds match the obligation, then checks only whether any current draft exists before creating another.",
            "failureScenario": "If the supplied history contains two matching current drafts—for example, after two evaluations both create a draft from the same empty history—Evaluate preserves both as Current. The result violates the criterion that exactly one draft is permitted for the at-risk case."
          }
        }
      ]
    },
