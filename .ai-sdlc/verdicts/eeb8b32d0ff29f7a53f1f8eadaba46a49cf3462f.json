      "findings": {
        "critical": 0,
        "major": 1,
        "minor": 0,
        "suggestion": 0
      },
      "summary": "The ACR grant contract test can misclassify a literal non-ACR resource scope as an ACR scope and reject a valid configuration.",
      "findingList": [
        {
          "severity": "major",
          "file": "backend/AirlineDemo.Api.Tests/ReleaseIdentityContractTests.cs",
          "line": 126,
          "message": "Exclude literal Azure resource IDs for non-ACR providers from the ACR grant results; otherwise valid app grants on other resources fail AC RELEASE-ID-01.",
          "confidence": 0.9,
          "category": "logic-error",
          "evidence": {
            "codePathTraced": "MayReferenceAcr treats an unrecognized literal Azure resource ID as a possible ACR scope, so AppAcrGrantRoles includes that assignment in its ACR role results.",
            "failureScenario": "If the app identity has its required AcrPull grant on the ACR and a valid grant on a literal Key Vault resource ID, the test counts both as ACR grants and fails the exact-one assertion, although only one grant is scoped to the ACR."
          }
        }
      ]
    },
    {
      "agentId": "test-reviewer-codex",
      "reviewType": "testing",
      "harness": "codex",
      "harnessVersion": "0.162.0",
      "model": "gpt-6-luna",
      "approved": false,
      "findings": {
        "critical": 0,
        "major": 3,
        "minor": 0,
        "suggestion": 0
      },
      "summary": "The signing identity uses a standalone key rather than the certificate's backing key, so signatures cannot be verified with the certificate. The required role-assignment baseline and separate-key prohibition assertions are also missing.",
      "findingList": [
        {
          "severity": "major",
          "file": "infra/terraform/release-identity.tf",
          "line": 67,
          "message": "Remove the separate signing key and grant Crypto User on the key created for the signing certificate; the current configuration makes signatures unverifiable with that certificate.",
          "confidence": 0.99,
          "category": "logic-error",
          "evidence": {
            "codePathTraced": "The release identity's Crypto User assignment uses azurerm_key_vault_key.signing.resource_versionless_id at line 104, while the certificate resource creates a separate backing key.",
            "failureScenario": "When the release workflow signs with the standalone key, verification against the certificate's public key fails because they are different keys. AC RELEASE-ID-07 requires signing with the certificate's backing key (OWASP A08:2025 Software and Data Integrity Failures)."
          }
        },
        {
          "severity": "major",
          "file": "backend/AirlineDemo.Api.Tests/ReleaseIdentityContractTests.cs",
          "line": 61,
          "message": "AC RELEASE-ID-06's required Role_assignments_are_held_to_a_baseline test is missing; assert the complete listed role-assignment name set.",
          "confidence": 0.98,
          "category": "testing",
          "evidence": {
            "codePathTraced": "The RELEASE-ID-06 test checks module blocks and indirect principal or scope expressions, but does not compare role-assignment names against the criterion's explicit baseline.",
            "failureScenario": "If a role assignment is added or renamed while retaining direct principal and scope references, this test has no baseline assertion to fail as AC RELEASE-ID-06 requires."
          }
        },
        {
          "severity": "major",
          "file": "backend/AirlineDemo.Api.Tests/ReleaseIdentityContractTests.cs",
          "line": 103,
          "message": "Add the AC RELEASE-ID-07 assertion that release-identity.tf declares no separate azurerm_key_vault_key resource.",
          "confidence": 0.98,
          "category": "testing",
          "evidence": {
            "codePathTraced": "Release_identity_contracts_are_complete checks identity resources, federation, role assignments, ACR grants, and outputs, but does not assert that release-identity.tf contains no azurerm_key_vault_key resource. The Terraform test also mocks and asserts the standalone key.",
            "failureScenario": "If the separate key remains or is reintroduced, the named behavior test passes without detecting the violation, despite AC RELEASE-ID-07 requiring it to fail."
          }
        }
      ]
    },
