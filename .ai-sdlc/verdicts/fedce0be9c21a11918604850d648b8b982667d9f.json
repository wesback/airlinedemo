        "minor": 0,
        "suggestion": 0
      },
      "summary": "The intake has a reachable false rejection: ordinary text containing `/ObjStm` is treated as unsupported PDF structure. This prevents valid text-only evidence from being accepted.",
      "findingList": [
        {
          "severity": "major",
          "file": "backend/AirlineDemo.Api/Evidence/EvidenceIntake.cs",
          "line": 172,
          "message": "The raw `/ObjStm` scan rejects valid text that happens to contain that literal. Parse the PDF structure when deciding whether it uses object streams, or otherwise avoid treating text content as a structural marker.",
          "confidence": 0.94,
          "category": "logic-error",
          "evidence": {
            "codePathTraced": "ValidateBytes calls RejectCompressedStructure before parsing. That method applies NameRegex to the entire raw PDF, without distinguishing PDF names from text strings.",
            "failureScenario": "A valid text-only PDF contains the literal `/ObjStm` in page text. The scan matches it and returns UnsupportedFormat before PdfPig parses the document, so ordinary text evidence is rejected."
          }
        }
      ]
    },
    {
      "agentId": "test-reviewer-codex",
      "reviewType": "testing",
      "harness": "codex",
      "harnessVersion": "0.162.0",
      "model": "gpt-6-luna",
      "approved": false,
      "findings": {
        "critical": 0,
        "major": 1,
        "minor": 0,
        "suggestion": 0
      },
      "summary": "The tests cover many intake and storage behaviors, but do not verify rejection of a valid PDF containing a Form XObject.",
      "findingList": [
        {
          "severity": "major",
          "file": "backend/AirlineDemo.Api.Tests/EvidenceIntakeTests.cs",
          "line": 115,
          "message": "Add a criterion-linked test using a valid text PDF with a /Form XObject; current tests do not protect the required Form XObject rejection behavior.",
          "confidence": 0.92,
          "category": "testing",
          "evidence": {
            "codePathTraced": "The page-content acceptance criterion requires rejecting /Resources /XObject entries with subtype /Form. The image theory uses malformed PDF stubs that fail as Corrupt, and the inline-image test does not exercise a Form XObject.",
            "failureScenario": "If Form XObject rejection is removed, a valid text PDF with a /Form XObject can still pass the existing tests and be returned as Complete. The required XObject rule therefore lacks a test that fails when its handling is broken."
          }
        }
      ]
    },
