      "summary": "The evaluator retains a current draft after the UTC notice window ends, allowing an expired draft to receive a legal decision. The tests also do not verify the required precedence when ambiguous and stale evidence coexist.",
      "findingList": [
        {
          "severity": "major",
          "file": "backend/AirlineDemo.Api/Obligations/ObligationEvaluator.cs",
          "line": 99,
          "message": "A current draft remains valid after its notice window expires. Supersede it when evaluation is outside the window.",
          "confidence": 0.9,
          "category": "logic-error",
          "evidence": {
            "codePathTraced": "Evaluate preserves a matching current draft when the basis, state, and missing requirement IDs still match. That check does not consider whether the current UTC day remains inside the notice window; RecordLegalDecision accepts any current draft.",
            "failureScenario": "A draft is created during the notice window. If the same at-risk obligation is evaluated after the window ends, the draft remains Current and can still receive a legal decision, although the acceptance criterion permits drafts only within the inclusive UTC window."
          }
        },
        {
          "severity": "major",
          "file": "backend/AirlineDemo.Api.Tests/ObligationEvaluationTests.cs",
          "line": 25,
          "message": "Add a test for the Blocked-over-NeedsReview precedence case; the existing tests do not verify this ordering.",
          "confidence": 0.88,
          "category": "testing",
          "evidence": {
            "codePathTraced": "The state tests cover ambiguous evidence with missing requirements and stale evidence with missing requirements, but none combines ambiguous and stale evidence to verify that Blocked outranks NeedsReview.",
            "failureScenario": "If the evaluator returned NeedsReview when an obligation has both ambiguous evidence and stale satisfied evidence, the current tests could still pass. The acceptance criterion requires Blocked to take precedence over NeedsReview."
          }
        }
      ]
    },
