      "summary": "The default path creates per-investigation limits, but callers can disable them by explicitly supplying the public no-op implementation.",
      "findingList": [
        {
          "severity": "major",
          "file": "backend/AirlineDemo.Api/Investigation/BoundedInvestigator.cs",
          "line": 58,
          "message": "An explicitly supplied NoInvestigationLimits instance bypasses all required investigation budgets.",
          "confidence": 0.91,
          "category": "logic-error",
          "evidence": {
            "codePathTraced": "The constructor accepts any IInvestigationLimits implementation and stores it in _suppliedLimits. InvestigateAsync uses that instance directly; only an omitted limits argument creates default InvestigationLimits.",
            "failureScenario": "A caller passes NoInvestigationLimits.Instance, whose checks are no-ops. The investigation can then exceed the tool, model-call, time, token, and retry limits without recording a breach, contrary to M-09."
          }
        }
      ]
    },
