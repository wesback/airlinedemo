      "summary": "A content stream containing an endstream token in its data can bypass the text-source limit because the scanner truncates its measured length at that token.",
      "findingList": [
        {
          "severity": "major",
          "file": "backend/AirlineDemo.Api/Evidence/IsolatedPdfParser.cs",
          "line": 545,
          "message": "The preflight can undercount a content stream when its data contains the token endstream. Use the declared stream length to locate the data boundary so oversized text sources are rejected before the worker starts.",
          "confidence": 0.91,
          "category": "logic-error",
          "evidence": {
            "codePathTraced": "ReadIndirectObjects finds the first endstream token in the raw bytes and uses its position to set StreamLength. DecodedContentStreamLength then scans only those bytes, although the PDF stream's declared /Length determines where its data ends.",
            "failureScenario": "A valid PDF has a content stream whose declared /Length covers more than 524288 bytes, with an endstream token in the stream data before a large text-showing operation. The preflight counts only the prefix before that token, so the oversized text source can reach the worker instead of being rejected."
          }
        }
      ]
    },
    {
      "agentId": "test-reviewer-codex",
      "reviewType": "testing",
      "harness": "codex",
      "harnessVersion": "0.162.0",
