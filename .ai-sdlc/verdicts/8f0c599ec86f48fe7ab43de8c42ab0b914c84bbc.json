          "severity": "major",
          "file": "backend/AirlineDemo.Api/Finance/ReserveCalculator.cs",
          "line": 174,
          "message": "Validate that a draft being approved is a valid calculated draft; checking only its status allows fabricated drafts and totals to be approved.",
          "confidence": 0.87,
          "category": "logic-error",
          "evidence": {
            "codePathTraced": "Review accepts a publicly constructible ReserveDraft and, for approvals, checks only that its Status is ReadyForReview before recording the supplied total and calculation basis.",
            "failureScenario": "A caller with a valid reviewer session constructs a ReadyForReview draft with no source reports or charge lines and an arbitrary payable total. Review accepts it and records an approval instead of rejecting the malformed draft."
          }
        }
      ]
