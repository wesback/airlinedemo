      },
      "summary": "The intake enforces the stated package limits and rejects several parsed PDF payload types. However, a JavaScript action chained through an annotation’s /Next entry can pass validation.",
      "findingList": [
        {
          "severity": "major",
          "file": "backend/AirlineDemo.Api/Evidence/EvidenceIntake.cs",
          "line": 233,
          "message": "Annotation action chains can carry JavaScript through /Next and bypass the parsed active-content check (A06:2025).",
          "confidence": 0.9,
          "category": "logic-error",
          "evidence": {
            "codePathTraced": "RejectAnnotationContent resolves an annotation's /A action and rejects it only when that action's /S value is /JavaScript. It does not inspect the action's /Next entry.",
            "failureScenario": "A text PDF has an annotation action with /S /URI and a /Next action with /S /JavaScript. The top-level action is not rejected, so text extraction can complete and the script-bearing PDF can be accepted as evidence, contrary to the acceptance criterion. This is an insecure-design risk (A06:2025)."
          }
        }
      ]
    },
    {
      "agentId": "test-reviewer-codex",
      "reviewType": "testing",
      "harness": "codex",
      "harnessVersion": "0.162.0",
      "model": "gpt-6-luna",
      "approved": false,
      "findings": {
        "critical": 0,
        "major": 1,
        "minor": 0,
        "suggestion": 0
      },
      "summary": "The tests cover the stated size boundaries, retryable failures, immutable versions, and failed intake. Annotation actions other than JavaScript can bypass the active-content check.",
      "findingList": [
        {
          "severity": "major",
          "file": "backend/AirlineDemo.Api/Evidence/EvidenceIntake.cs",
          "line": 211,
          "message": "Reject executable annotation actions such as /Launch; the current check only blocks JavaScript actions, allowing a PDF with a launch action to be accepted as evidence.",
          "confidence": 0.87,
          "category": "security",
          "evidence": {
            "codePathTraced": "RejectAnnotationContent inspects an annotation's /A action but rejects it only when /S is /JavaScript. Other executable action types pass this check.",
            "failureScenario": "A text PDF has a page Link annotation with /A << /S /Launch /F (program.exe) >> and no catalog OpenAction. The annotation check does not reject it, so text extraction can return Complete for a PDF containing an executable launch action, contrary to the acceptance criterion. OWASP A06:2025 (Insecure Design)."
          }
        }
      ]
    },
    {
      "agentId": "security-reviewer",
      "reviewType": "security",
      "harness": "codex",
      "harnessVersion": "0.162.0",
      "model": "gpt-6-luna",
      "approved": false,
      "findings": {
        "critical": 0,
        "major": 1,
        "minor": 0,
        "suggestion": 0
      },
      "summary": "The parsed-content checks avoid raw-token scanning, but the decoded-stream size check occurs after decompression and does not prevent resource exhaustion from a compressed PDF.",
      "findingList": [
        {
          "severity": "major",
          "file": "backend/AirlineDemo.Api/Evidence/EvidenceIntake.cs",
          "line": 267,
          "message": "The decoded stream limits are checked only after decoding has materialized the stream, so a compressed PDF can exhaust service resources before intake rejects it.",
          "confidence": 0.86,
          "category": "security",
          "evidence": {
            "codePathTraced": "MeasureDecodedContent calls stream.Decode(DefaultFilterProvider.Instance).Count before comparing the decoded length with MaxDecodedBytesPerStream or MaxDecodedBytesPerDocument. Decoding must produce the decoded data before either limit can reject it.",
            "failureScenario": "A caller submits a PDF within the 10 MB input limit containing a highly compressed content stream that expands to a very large size. PdfPig decodes and allocates that data before the limit check, potentially exhausting service memory and disrupting other intake requests. This is an unbounded resource risk (A06:2025, Insecure Design)."
          }
        }
      ]
    }
  ],
