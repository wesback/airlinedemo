        "suggestion": 0
      },
      "summary": "The intake can accept a text PDF whose page dictionary contains a prohibited active-content key. The page checks reject only /AF and /AA before checking annotations and XObjects.",
      "findingList": [
        {
          "severity": "major",
          "file": "backend/AirlineDemo.Api/Evidence/EvidenceIntake.cs",
          "line": 280,
          "message": "The page-level rejection list is incomplete: keys such as /JavaScript, /Launch, /OpenAction, /Names, /AcroForm, and /EmbeddedFiles can pass intake, contrary to the required closed rejection rules.",
          "confidence": 0.94,
          "category": "logic-error",
          "evidence": {
            "codePathTraced": "The page loop checks only /AF and /AA, then RejectPageContent checks /Annots and XObject subtypes. It never rejects other prohibited keys on a page.",
            "failureScenario": "A parseable text PDF has a page dictionary containing /JavaScript but no /AF, /AA, /Annots, or image/form XObject. The page checks pass, text extraction succeeds, and Process returns Complete despite the criterion requiring rejection when any page has /JavaScript. This is an insecure-design gap (A06:2025)."
          }
        }
      ]
    },
    {
      "agentId": "test-reviewer-codex",
      "reviewType": "testing",
      "harness": "codex",
      "harnessVersion": "0.162.0",
      "model": "gpt-6-luna",
      "approved": false,
      "findings": {
        "critical": 0,
        "major": 2,
        "minor": 0,
        "suggestion": 0
      },
      "summary": "The intake can accept script-bearing evidence through prohibited page-level keys. The tests also do not cover every allowlist rule as required.",
      "findingList": [
        {
          "severity": "major",
          "file": "backend/AirlineDemo.Api/Evidence/EvidenceIntake.cs",
          "line": 385,
          "message": "Page-level /OpenAction, /Names, /AcroForm, /EmbeddedFiles, /JavaScript, and /Launch entries bypass the required closed allowlist.",
          "confidence": 0.96,
          "category": "logic-error",
          "evidence": {
            "codePathTraced": "The page loop rejects only /AF and /AA. RejectPageContent checks /Annots and image or form XObjects, but no check rejects the other prohibited keys on a page.",
            "failureScenario": "A parseable text PDF has a page-level /OpenAction containing a JavaScript action. It passes the catalog checks and the page checks, so text extraction can return Complete for script-bearing evidence, despite the acceptance criterion requiring rejection. This is an insecure-design risk (A06:2025)."
          }
        },
        {
          "severity": "major",
          "file": "backend/AirlineDemo.Api.Tests/EvidenceIntakeTests.cs",
          "line": 1,
          "message": "The allowlist acceptance criterion lacks the required one-case-per-rule test coverage.",
          "confidence": 0.94,
          "category": "testing",
          "evidence": {
            "codePathTraced": "The tests cover selected cases such as catalog /AcroForm and page /AA, but do not exercise each allowlist rule with a PDF that violates only that rule; for example, there is no test for an unapproved catalog key or page-level /OpenAction.",
            "failureScenario": "If the catalog allowlist stops rejecting an entry such as /CustomKey, or a prohibited page key is accepted, the current tests can still pass. The acceptance criterion explicitly requires one violating PDF per allowlist rule."
          }
        }
      ]
    },
    {
      "agentId": "security-reviewer",
      "reviewType": "security",
      "harness": "codex",
      "harnessVersion": "0.162.0",
      "model": "gpt-6-luna",
      "approved": false,
      "findings": {
        "critical": 0,
        "major": 1,
        "minor": 0,
        "suggestion": 0
      },
      "summary": "The explicit limits cover page content streams, but parsing starts before those checks and can process other compressed streams first.",
      "findingList": [
        {
          "severity": "major",
          "file": "backend/AirlineDemo.Api/Evidence/EvidenceIntake.cs",
          "line": 365,
          "message": "PDF parsing can decompress object streams before the decoded-size limits are checked, leaving a reachable resource-exhaustion path.",
          "confidence": 0.84,
          "category": "security",
          "evidence": {
            "codePathTraced": "ExtractDocument opens the PDF with PdfDocument.Open before the page loop calls MeasureDecodedContent. That check only measures page /Contents streams, so compressed object streams needed during parsing are not bounded.",
            "failureScenario": "A caller submits a PDF under the 10 MB input limit whose compressed object stream expands beyond the decoded-stream limit. PdfPig may decompress it while opening the PDF, before the explicit size checks run, allowing excessive memory use or service exhaustion (A06:2025, Insecure Design)."
          }
        }
      ]
    }
  ],
