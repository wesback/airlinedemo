        "minor": 0,
        "suggestion": 0
      },
      "summary": "The Terraform tests cover the listed grant scopes and alert routing, but the shared identity mock value leaves a gap in verifying that app grants belong to the app identity.",
      "findingList": [
        {
          "severity": "major",
          "file": "infra/terraform/tests/identity-telemetry.tftest.hcl",
          "line": 269,
          "message": "The M-14 principal-binding test cannot detect app grants assigned to the migration identity because both mocked identities have the same principal ID.",
          "confidence": 0.95,
          "category": "testing",
          "evidence": {
            "codePathTraced": "The app grant assertions compare principal_id with the app identity's principal_id, but the azurerm_user_assigned_identity mock gives every identity the same principal_id.",
            "failureScenario": "If an app grant is mistakenly bound to the migration identity, the mock IDs remain equal and the test passes, even though the app identity lacks that grant."
          }
        }
      ]
    },
