      "summary": "The source checker accepts npmjs.org lockfile URLs without checking whether npm configuration redirects those URLs to a different registry. A PR-controlled .npmrc can therefore bypass the package source restriction before npm ci runs.",
      "findingList": [
        {
          "severity": "major",
          "file": "backend/ci/check-sources.mjs",
          "line": 36,
          "message": "A08:2025 — Validate the effective npm registry or reject registry.npmjs.org lockfile URLs when a custom registry is configured; otherwise npm can fetch packages from an unapproved host.",
          "confidence": 0.86,
          "category": "security",
          "evidence": {
            "codePathTraced": "The checker accepts lockfile URLs on registry.npmjs.org but does not check the npm registry configuration. npm treats registry.npmjs.org lockfile URLs as the currently configured registry.",
            "failureScenario": "A pull request adds a frontend/.npmrc pointing to an attacker-controlled registry while leaving approved registry.npmjs.org URLs in package-lock.json. The checker passes, then npm ci can fetch packages from the configured registry and run their install scripts, bypassing M-14's source restriction (OWASP A08:2025)."
          }
        }
      ]
    }
