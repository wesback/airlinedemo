      "summary": "The store protects returned collections and rejects conflicting receipt payloads in common cases, but receipt replay can bypass M-10's digest validation for a changed basis content payload.",
      "findingList": [
        {
          "severity": "major",
          "file": "backend/AirlineDemo.Api/Persistence/CaseStateStore.cs",
          "line": 144,
          "message": "Receipt replay can bypass basis digest validation when the content changes but the claimed digest fields are reused.",
          "confidence": 0.91,
          "category": "logic-error",
          "evidence": {
            "codePathTraced": "Commit checks for a recorded receipt and returns Replayed before validating the incoming basis content digest. Fingerprint omits NewBasis.Content and includes only its version and claimed digests.",
            "failureScenario": "After a basis commit records receipt-1, a retry reuses receipt-1 and the original digest fields but supplies different content. The fingerprint matches, so Commit reports a successful replay instead of rejecting the mismatched content digest required by M-10."
          }
        }
      ]
    },
    {
      "agentId": "test-reviewer-codex",
      "reviewType": "testing",
      "harness": "codex",
      "harnessVersion": "0.162.0",
