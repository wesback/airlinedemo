        "suggestion": 0
      },
      "summary": "The shared redaction filter does not enforce AC-05's error.type allowlist for structured attributes or scope values, allowing unapproved values to reach telemetry.",
      "findingList": [
        {
          "severity": "major",
          "file": "backend/AirlineDemo.Api/Diagnostics/RedactionFilter.cs",
          "line": 106,
          "message": "Unapproved error.type values bypass the allowlist and can be exported.",
          "confidence": 0.94,
          "category": "security",
          "evidence": {
            "codePathTraced": "RedactAttributes passes every non-sensitive key through TryRedact, which does not apply the required error.type allowlist.",
            "failureScenario": "A log record or scope contains error.type=CANARY-ERROR. The value passes through unchanged and can reach the configured exporter, although AC-05 requires values that fail the allowlist to be omitted. OWASP A09:2025."
          }
        }
      ]
    }
