      "summary": "The logging and trace pipelines cover the specified redaction paths, but the exception type handling does not preserve the required `invalid-operation` value.",
      "findingList": [
        {
          "severity": "major",
          "file": "backend/AirlineDemo.Api/Diagnostics/DiagnosticsSetup.cs",
          "line": 99,
          "message": "AC-05’s required allowlisted value `error.type=invalid-operation` is not preserved for InvalidOperationException logs.",
          "confidence": 0.98,
          "category": "logic-error",
          "evidence": {
            "codePathTraced": "The processor passes exception.GetType().FullName to TelemetryRedaction.Redact as error.type. The allowlist accepts lowercase dotted or hyphenated values.",
            "failureScenario": "When a structured log includes an InvalidOperationException, its type name is System.InvalidOperationException, which fails the lowercase allowlist and is omitted. AC-05 requires error.type=invalid-operation to be preserved; the test uses a custom lowercase exception type instead."
          }
        }
      ]
    },
    {
      "agentId": "test-reviewer-codex",
