      "summary": "Compressed PDF content streams can hide inline images from the raw-byte scan. Such a PDF can still pass text extraction and be accepted as complete evidence.",
      "findingList": [
        {
          "severity": "major",
          "file": "backend/AirlineDemo.Api/Evidence/EvidenceIntake.cs",
          "line": 189,
          "message": "The inline-image check misses operators inside compressed page content streams, allowing an image-bearing PDF to be accepted as evidence (A06:2025, Insecure Design).",
          "confidence": 0.91,
          "category": "security",
          "evidence": {
            "codePathTraced": "ValidateBytes searches raw PDF bytes for inline-image operators, then ExtractDocument passes unflagged PDFs to PdfPig.",
            "failureScenario": "An attacker submits a valid PDF whose FlateDecode-compressed page content contains extractable text and a BI ... ID ... EI inline image. The raw-byte check cannot see the operator, PdfPig extracts the text, and Process returns Complete despite the requirement to reject image payloads."
          }
        }
      ]
