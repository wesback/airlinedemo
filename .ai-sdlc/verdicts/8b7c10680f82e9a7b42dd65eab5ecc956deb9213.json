      "summary": "Provisioning can fail because the certificate creates a backing key and secret that conflict with the separately declared key using the same name.",
      "findingList": [
        {
          "severity": "major",
          "file": "infra/terraform/release-identity.tf",
          "line": 74,
          "message": "The signing key and certificate share the same default name in the same Key Vault, causing a resource name conflict during provisioning.",
          "confidence": 0.98,
          "category": "logic-error",
          "evidence": {
            "codePathTraced": "The signing key and certificate use separate Terraform resources in the same Key Vault. Both name variables default to \"release-image-signing\".",
            "failureScenario": "On apply, creating the certificate also creates a Key Vault key and secret with the certificate's name. Because the separate signing key already uses that name, Azure rejects one of the creations with a conflict, so provisioning cannot complete."
          }
        }
