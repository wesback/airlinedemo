      "summary": "The command’s production dependency registration is incomplete: SourceModeStore requires TimeProvider, but the production service registrations do not provide it.",
      "findingList": [
        {
          "severity": "major",
          "file": "backend/AirlineDemo.Api/Program.cs",
          "line": 25,
          "message": "Register TimeProvider in production so the mode command can resolve SourceModeStore.",
          "confidence": 0.98,
          "category": "logic-error",
          "evidence": {
            "codePathTraced": "Program registers SourceModeStore, whose constructor requires TimeProvider. The production registrations shown do not register TimeProvider; only the command test factory adds one.",
            "failureScenario": "In production, a presenter submits an authenticated, CSRF-valid mode command. Dependency injection cannot construct SourceModeStore because TimeProvider is unregistered, so the command fails instead of changing the source mode."
          }
        }
      ]
    },
