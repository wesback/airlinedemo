      "summary": "The named tests exercise the command, denial, replay, conflict, stale revision, unchanged mode, and reset behaviors. AC-014 leaves the serialized audit detail’s caseId value unchecked.",
      "findingList": [
        {
          "severity": "minor",
          "file": "backend/AirlineDemo.Api.Tests/SourceModeCommandTests.cs",
          "line": 110,
          "message": "AC-014 does not assert the audit detail’s caseId value. Add an exact assertion against the requested case ID.",
          "confidence": 0.95,
          "category": "testing",
          "evidence": {
            "codePathTraced": "AC-014 checks the audit detail’s field names and several values, but never checks the value of its caseId field.",
            "failureScenario": "If the serialized audit detail contains an incorrect caseId while the receipt and other audit fields remain correct, this test still passes."
          }
        }
      ]
