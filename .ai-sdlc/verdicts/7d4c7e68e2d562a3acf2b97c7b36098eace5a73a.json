      "summary": "Following symlink targets can expose their contents to gitleaks, but the copy loop also aborts on directory or dangling targets. That can keep the Secret scan failing before gitleaks evaluates the tracked files.",
      "findingList": [
        {
          "severity": "major",
          "file": ".github/workflows/build.yml",
          "line": 67,
          "message": "Handle tracked symlinks whose targets are directories or missing; `cp -L` currently makes either case abort the secret scan.",
          "confidence": 0.84,
          "category": "logic-error",
          "evidence": {
            "codePathTraced": "The Secret scan loop runs `cp -L` for each path from `git ls-files -z`; the script uses `set -euo pipefail`, so a failed copy aborts the step before gitleaks runs.",
            "failureScenario": "If a tracked symlink points to a directory or a missing target, `cp -L` cannot copy it to the neutral file path and exits nonzero, causing Secret scan to fail even when gitleaks would find no credential."
          }
        }
      ]
    },
