      "summary": "The tests map to the listed parser behaviors, including intake routing, limits, the bomb, and the empty environment. The working-directory permission requirement is unmet on Windows.",
      "findingList": [
        {
          "severity": "major",
          "file": "backend/AirlineDemo.Api/Evidence/IsolatedPdfParser.cs",
          "line": 47,
          "message": "The worker's working directory is not made read-only on Windows.",
          "confidence": 0.95,
          "category": "security A02:2025",
          "evidence": {
            "codePathTraced": "Parse creates the worker directory, but applies read-only permissions only when the OS is not Windows.",
            "failureScenario": "On Windows, the child runs under the API identity with a writable temporary working directory. If parsing is exploited, code in the child can create files there, contrary to the acceptance criterion requiring a read-only working directory."
          }
        }
