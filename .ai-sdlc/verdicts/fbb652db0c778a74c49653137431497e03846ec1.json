      "summary": "The trace lifecycle is wired into package submission, but rejected and escalated investigations omit the deterministic-policy handover required by AC TRACE-PRODUCER-04.",
      "findingList": [
        {
          "severity": "major",
          "file": "backend/AirlineDemo.Api/Investigation/InvestigationExecutionService.cs",
          "line": 34,
          "message": "Started investigations that finish with a rejected or escalated outcome are persisted without the required deterministic-policy handover.",
          "confidence": 0.95,
          "category": "logic-error",
          "evidence": {
            "codePathTraced": "When investigation execution throws, this catch calls InvestigationTraceRecorder.Reject, which appends the trace without a deterministic-policy handover step. For example, an empty claims array causes BoundedInvestigator to throw InvestigationOutputException, reaching this path with outcome \"rejected\".",
            "failureScenario": "A started investigation returns [] and completes as rejected. Its trace is persisted without the deterministic-policy handover required by AC TRACE-PRODUCER-04 for approved, rejected, and escalated outcomes."
          }
        }
      ]
