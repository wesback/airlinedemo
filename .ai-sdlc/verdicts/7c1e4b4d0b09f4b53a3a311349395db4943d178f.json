      "summary": "The gate checks a single hash for the whole request, so it refuses requests composed of multiple individually registered evidence items. The remaining changed behavior appears covered by the supplied tests.",
      "findingList": [
        {
          "severity": "major",
          "file": "backend/AirlineDemo.Api/Investigation/ApprovedModelManifest.cs",
          "line": 270,
          "message": "M-07 requires authorization when every evidence item is registered, but the gate checks only the hash of the entire request content. Represent and verify the evidence items individually.",
          "confidence": 0.86,
          "category": "logic-error",
          "evidence": {
            "codePathTraced": "Authorize hashes the entire request.Content and checks for that single hash in SyntheticContentRegistry. It has no way to verify each evidence item separately.",
            "failureScenario": "A request contains two evidence items whose individual SHA-256 hashes are both registered from committed fixtures. Their combined request content has a different hash, so Authorize refuses the request even though every item is registered, contrary to M-07."
          }
        }
      ]
