          "severity": "major",
          "file": "backend/AirlineDemo.Api/Evidence/IsolatedPdfParser.cs",
          "line": 36,
          "message": "Default PDF parsing is disabled for non-root Linux deployments. The worker should be able to start with the read-only working directory without requiring the API to run as root.",
          "confidence": 0.99,
          "category": "logic-error",
          "evidence": {
            "codePathTraced": "Parse returns before starting the worker when running on Linux with default options and DropsToNobody() is false. DropsToNobody() is false for non-root API processes.",
            "failureScenario": "When the API runs as a non-root user on Linux, every intake PDF returns a retryable failure without being parsed, including valid PDFs."
          }
        }
