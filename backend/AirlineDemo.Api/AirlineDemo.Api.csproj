<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Investigation/SyntheticFixtures/*.txt" />
    <EmbeddedResource Include="Auth/Fixtures/demo-users-v1.json" LogicalName="AirlineDemo.Api.Auth.Fixtures.demo-users-v1.json" />
    <EmbeddedResource Include="Fixtures/sources/technical.json" LogicalName="AirlineDemo.Api.Fixtures.sources.technical.json" />
    <EmbeddedResource Include="Fixtures/sources/finance.json" LogicalName="AirlineDemo.Api.Fixtures.sources.finance.json" />
    <EmbeddedResource Include="Fixtures/sources/maintenance.json" LogicalName="AirlineDemo.Api.Fixtures.sources.maintenance.json" />
    <EmbeddedResource Include="Fixtures/sources/records.json" LogicalName="AirlineDemo.Api.Fixtures.sources.records.json" />
    <EmbeddedResource Include="Fixtures/sources/contracts.json" LogicalName="AirlineDemo.Api.Fixtures.sources.contracts.json" />
    <Content Include="Fixtures/sources/*.sig" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Monitor.OpenTelemetry.Exporter" Version="1.3.0" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.30.1" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.9.0" />
    <PackageReference Include="Microsoft.Agents.AI" Version="1.24.0" />
    <PackageReference Include="Microsoft.Agents.AI.OpenAI" Version="1.24.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.0" />
    <PackageReference Include="UglyToad.PdfPig" Version="1.7.0-custom-5" />
  </ItemGroup>
  <!-- Publish builds the React client and stages frontend/dist into the published wwwroot (DD-013). -->
  <Target Name="BuildAndStageClient" AfterTargets="ComputeResolvedFilesToPublishList">
    <Exec Command="npm --prefix &quot;$(MSBuildProjectDirectory)/../../frontend&quot; run build" />
    <ItemGroup>
      <ClientBuildFile Include="$(MSBuildProjectDirectory)/../../frontend/dist/**/*" />
    </ItemGroup>
    <ItemGroup>
      <ResolvedFileToPublish Include="@(ClientBuildFile)" RelativePath="wwwroot/%(ClientBuildFile.RecursiveDir)%(ClientBuildFile.Filename)%(ClientBuildFile.Extension)" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <InternalsVisibleTo Include="AirlineDemo.Api.Tests" />
  </ItemGroup>
</Project>
